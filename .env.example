# ========================================================
# DANDIYA NIGHT 3.0 — BACKEND ENVIRONMENT VARIABLES
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/dandiya_db"

# Session & Cryptographic Token Salts
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HEX_64_CHARS
TICKET_SECURITY_SALT=dandiya_secure_token_salt_2026_super_secret_hex
SESSION_EXPIRY_DAYS=7

# Official Razorpay Gateway Integration
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Cloudinary Official Media Storage
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# Resend Transactional Email API
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=tickets@dandiyanight.in

# Super Admin Initial Provisioning (Used during bootstrap seed)
SUPER_ADMIN_EMAIL=admin@dandiyanight.in
SUPER_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD
SUPER_ADMIN_PHONE=+919876543210

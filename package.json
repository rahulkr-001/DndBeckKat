    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "next": "16.4.0",
    "pdfkit": "^0.20.2",
    "prisma": "6.4.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.15",
